APP_NAME="MotorPress"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=
APP_LOCALE=es_ES
APP_TIMEZONE=Europe/Madrid

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=revista_coches
DB_USER=revista_app
DB_PASS=
DB_CHARSET=utf8mb4

DB_ROOT_USER=
DB_ROOT_PASS=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

SESSION_NAME=mp_session
SESSION_LIFETIME=7200

MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=MotorPress

RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=300

# ---------------------------------------------------------------------------
# Endurecimiento del panel (README §7)
# ---------------------------------------------------------------------------
# Nivel jerárquico mínimo exigido para entrar en /admin (90 = administrador).
PANEL_NIVEL=90
# Segundos sin actividad antes de cerrar la sesión del panel (900 = 15 min).
PANEL_INACTIVIDAD=900
# Registro público de cuentas. Con «false» sólo el propietario da de alta
# usuarios desde el panel; nadie puede crear identidades desde la web.
REGISTRO_ABIERTO=false
# Hash Argon2id de la clave maestra del panel. NO se guarda la clave, sólo
# su hash: se crea o rota con `php scripts/panel_clave.php`.
PANEL_CLAVE_HASH=
