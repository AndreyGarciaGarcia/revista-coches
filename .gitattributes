# =====================================================================
#  MotorPress · Finales de línea
# =====================================================================
#
#  El proyecto se clona y se despliega en Linux; el repositorio guarda
#  todo en LF para que los checksums de las migraciones y los .htaccess
#  sean idénticos en cualquier sistema.
# =====================================================================

*       text=auto

*.php   text eol=lf
*.sql   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.env   text eol=lf
*.example text eol=lf

# .htaccess sin extensión
.htaccess      text eol=lf
public/.htaccess text eol=lf

# Binarios
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.svg   text eol=lf
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.gz    binary
